{
  "$schema": "zen://schemas/settings",
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark"
  },
  "icon_theme": "Zen (Default)",
  "base_keymap": "VSCode",
  "buffer_font_family": ".ZenMono",
  "buffer_font_fallbacks": null,
  "buffer_font_features": {},
  "buffer_font_size": 15,
  "buffer_font_weight": 400,
  "buffer_line_height": "comfortable",
  "ui_font_family": ".ZenSans",
  "ui_font_fallbacks": null,
  "ui_font_features": {
    "calt": false
  },
  "ui_font_weight": 400,
  "ui_font_size": 16,
  "unnecessary_code_fade": 0.3,
  "active_pane_modifiers": {
    "border_size": 0.0,
    "inactive_opacity": 1.0
  },
  "bottom_dock_layout": "contained",
  "pane_split_direction_horizontal": "down",
  "pane_split_direction_vertical": "right",
  "centered_layout": {
    "left_padding": 0.2,
    "right_padding": 0.2
  },
  "multi_cursor_modifier": "alt",
  "confirm_quit": false,
  "restore_on_startup": "last_session",
  "cli_default_open_behavior": "existing_window",
  "restore_on_file_reopen": true,
  "close_on_file_delete": false,
  "close_panel_on_toggle": false,
  "drop_target_size": 0.2,
  "when_closing_with_no_tabs": "platform_default",
  "on_last_window_closed": "platform_default",
  "text_rendering_mode": "platform_default",
  "zoomed_padding": true,
  "window_decorations": "client",
  "use_system_path_prompts": true,
  "use_system_prompts": true,
  "cursor_blink": true,
  "cursor_shape": "bar",
  "hide_mouse": "on_typing_and_movement",
  "focus_follows_mouse": {
    "enabled": false,
    "debounce_ms": 250
  },
  "current_line_highlight": "all",
  "selection_highlight": true,
  "rounded_selection": true,
  "minimum_contrast_for_highlights": 45,
  "show_completions_on_input": false,
  "show_completion_documentation": false,
  "colorize_brackets": false,
  "completion_menu_scrollbar": "never",
  "completion_detail_alignment": "left",
  "diff_view_style": "split",
  "minimum_split_diff_width": 100,
  "drag_and_drop_selection": {
    "enabled": true,
    "delay": 300
  },
  "show_wrap_guides": true,
  "wrap_guides": [],
  "redact_private_values": false,
  "expand_excerpt_lines": 5,
  "excerpt_context_lines": 2,
  "private_files": [
    "**/.env*",
    "**/*.pem",
    "**/*.key",
    "**/*.cert",
    "**/*.crt",
    "**/secrets.yml"
  ],
  "use_on_type_format": true,
  "use_autoclose": true,
  "use_auto_surround": true,
  "auto_indent": "syntax_aware",
  "auto_indent_on_paste": true,
  "always_treat_brackets_as_autoclosed": false,
  "allow_rewrap": "in_comments",
  "show_whitespaces": "selection",
  "whitespace_map": {
    "space": "\u2022",
    "tab": "\u2192"
  },
  "toolbar": {
    "quick_actions": true,
    "selections_menu": true,
    "code_actions": false
  },
  "use_system_window_tabs": false,
  "title_bar": {
    "show_branch_status_icon": false,
    "show_branch_name": true,
    "show_project_items": true,
    "show_menus": false,
    "button_layout": "platform_default"
  },
  "scrollbar": {
    "show": "auto",
    "cursors": true,
    "git_diff": true,
    "search_results": true,
    "selected_text": true,
    "selected_symbol": true,
    "axes": {
      "horizontal": true,
      "vertical": true
    },
    "diagnostics": "none"
  },
  "middle_click_paste": true,
  "double_click_in_multibuffer": "select",
  "gutter": {
    "line_numbers": true,
    "bookmarks": true,
    "folds": true,
    "min_line_number_digits": 4
  },
  "indent_guides": {
    "enabled": true,
    "line_width": 1,
    "active_line_width": 1,
    "coloring": "fixed",
    "background_coloring": "disabled"
  },
  "scroll_beyond_last_line": "one_page",
  "vertical_scroll_margin": 3,
  "autoscroll_on_clicks": false,
  "horizontal_scroll_margin": 5,
  "scroll_sensitivity": 1.0,
  "mouse_wheel_zoom": false,
  "fast_scroll_sensitivity": 4.0,
  "sticky_scroll": {
    "enabled": false
  },
  "relative_line_numbers": "disabled",
  "search_wrap": true,
  "search": {
    "button": true,
    "whole_word": false,
    "case_sensitive": false,
    "include_ignored": false,
    "regex": false,
    "center_on_match": false
  },
  "seed_search_query_from_cursor": "always",
  "use_smartcase_search": false,
  "resize_all_panels_in_dock": [
    "left"
  ],
  "project_panel": {
    "button": true,
    "hide_gitignore": false,
    "default_width": 240,
    "dock": "right",
    "entry_spacing": "comfortable",
    "file_icons": true,
    "folder_icons": true,
    "git_status": true,
    "indent_size": 20,
    "auto_reveal_entries": true,
    "starts_open": true,
    "auto_fold_dirs": true,
    "bold_folder_labels": false,
    "scrollbar": {
      "show": null,
      "horizontal_scroll": true
    },
    "sticky_scroll": true,
    "indent_guides": {
      "show": "always"
    },
    "sort_mode": "directories_first",
    "sort_order": "default",
    "git_status_indicator": false,
    "drag_and_drop": true,
    "hide_root": false,
    "hide_hidden": false,
    "auto_open": {
      "on_create": true,
      "on_paste": true,
      "on_drop": true
    },
    "show_diagnostics": "off",
    "diagnostic_badges": false
  },
  "git_panel": {
    "button": true,
    "dock": "right",
    "default_width": 360,
    "status_style": "icon",
    "file_icons": false,
    "folder_icons": true,
    "fallback_branch_name": "main",
    "sort_by_path": false,
    "collapse_untracked_diff": false,
    "tree_view": false,
    "starts_open": false,
    "show_count_badge": false,
    "scrollbar": {},
    "diff_stats": true,
    "commit_title_max_length": 72
  },
  "autosave": "off",
  "max_tabs": null,
  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": true,
    "show_tab_bar_buttons": true,
    "show_pinned_tabs_in_separate_row": false
  },
  "tabs": {
    "git_status": false,
    "close_position": "right",
    "file_icons": false,
    "show_close_button": "hover",
    "activate_on_close": "history",
    "show_diagnostics": "off"
  },
  "preview_tabs": {
    "enabled": true,
    "enable_preview_from_project_panel": true,
    "enable_preview_from_file_finder": false,
    "enable_preview_from_multibuffer": true,
    "enable_preview_multibuffer_from_code_navigation": false,
    "enable_preview_file_from_code_navigation": true,
    "enable_keep_preview_on_code_navigation": false
  },
  "file_finder": {
    "file_icons": true,
    "modal_max_width": "small",
    "skip_focus_for_active_in_search": true,
    "include_ignored": "smart",
    "include_channels": false
  },
  "remove_trailing_whitespace_on_save": true,
  "extend_comment_on_newline": true,
  "extend_list_on_newline": true,
  "indent_list_on_tab": true,
  "ensure_final_newline_on_save": true,
  "line_ending": "detect",
  "format_on_save": "off",
  "soft_wrap": "none",
  "preferred_line_length": 80,
  "hard_tabs": false,
  "tab_size": 4,
  "modeline_lines": 5,
  "word_diff_enabled": true,
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/.sl",
    "**/.repo",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings"
  ],
  "file_scan_inclusions": [
    ".env*"
  ],
  "hidden_files": [
    "**/.*"
  ],
  "read_only_files": [],
  "git": {
    "disable_git": false,
    "enable_status": true,
    "enable_diff": true,
    "git_gutter": "tracked_files",
    "gutter_debounce": 0,
    "inline_blame": {
      "enabled": true,
      "delay_ms": 0,
      "padding": 7,
      "show_commit_summary": false,
      "min_column": 0
    },
    "blame": {
      "show_avatar": true
    },
    "branch_picker": {
      "show_author_name": true
    },
    "hunk_style": "staged_hollow",
    "path_style": "file_name_first",
    "worktree_directory": "../worktrees"
  },
  "git_hosting_providers": [],
  "status_bar": {
    "experimental.show": true,
    "show_active_file": false,
    "active_language_button": true,
    "cursor_position_button": true,
    "line_endings_button": false,
    "active_encoding_button": "non_utf8"
  },
  "file_types": {
    "JSONC": [
      "**/.zen/*.json",
      "**/.vscode/**/*.json",
      "**/{zen,Zen}/{settings,keymap}.json",
      "tsconfig*.json"
    ],
    "Markdown": [
      ".rules",
      ".cursorrules",
      ".windsurfrules",
      ".clinerules"
    ],
    "Shell Script": [
      ".env.*"
    ]
  },
  "completions": {
    "words": "disabled",
    "words_min_length": 3,
    "lsp": false,
    "lsp_fetch_timeout_ms": 0,
    "lsp_insert_mode": "replace_suffix"
  },
  "languages": {
    "C": {
      "format_on_save": "off",
      "use_on_type_format": false
    },
    "C++": {
      "format_on_save": "off",
      "use_on_type_format": false
    },
    "Diff": {
      "remove_trailing_whitespace_on_save": false,
      "ensure_final_newline_on_save": false
    },
    "Git Commit": {
      "allow_rewrap": "anywhere",
      "soft_wrap": "editor_width",
      "preferred_line_length": 72
    },
    "Go": {
      "hard_tabs": true
    },
    "Markdown": {
      "format_on_save": "off",
      "use_on_type_format": false,
      "remove_trailing_whitespace_on_save": false,
      "allow_rewrap": "anywhere",
      "soft_wrap": "editor_width",
      "completions": {
        "words": "disabled"
      }
    },
    "Plain Text": {
      "allow_rewrap": "anywhere",
      "soft_wrap": "editor_width",
      "completions": {
        "words": "disabled"
      }
    }
  },
  "session": {
    "restore_unsaved_buffers": true,
    "trust_all_worktrees": false
  },
  "jsx_tag_auto_close": {
    "enabled": true
  },
  "linux": {},
  "macos": {},
  "windows": {
    "languages": {}
  },
  "line_indicator_format": "long",
  "proxy": "",
  "command_aliases": {},
  "log": {},
  "snippet_sort_order": "none",
  "inline_code_actions": false,
  "linked_edits": true,
  "enable_language_server": false,
  "language_servers": [
    "..."
  ],
  "semantic_tokens": "off",
  "code_actions_on_format": {},
  "formatter": "auto",
  "load_direnv": "direct",
  "lsp": {},
  "node": {
    "ignore_system_version": false,
    "path": null,
    "npm_path": null
  },
  "prettier": {
    "allowed": false,
    "plugins": [],
    "parser": ""
  },
  "diagnostics": {
    "button": false,
    "include_warnings": true,
    "lsp_pull_diagnostics": {
      "enabled": false,
      "debounce_ms": 50
    },
    "inline": {
      "enabled": false,
      "update_debounce_ms": 150,
      "padding": 4,
      "min_column": 0,
      "max_severity": null
    }
  },
  "global_lsp_settings": {
    "button": false,
    "request_timeout": 120,
    "notifications": {
      "dismiss_timeout_ms": 5000
    },
    "semantic_token_rules": []
  },
  "lsp_highlight_debounce": 75,
  "go_to_definition_fallback": "find_all_references",
  "go_to_definition_scroll_strategy": "center",
  "diagnostics_max_severity": "off"
}
