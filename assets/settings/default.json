{
  "$schema": "zen://schemas/settings",
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark"
  },
  "icon_theme": "Zen (Default)",
  "base_keymap": "VSCode",
  "buffer_font_family": ".SystemMonoFont",
  "buffer_font_fallbacks": null,
  "buffer_font_features": {},
  "buffer_font_size": 15,
  "buffer_font_weight": 400,
  "buffer_line_height": "comfortable",
  "ui_font_family": ".SystemUIFont",
  "ui_font_fallbacks": null,
  "ui_font_features": {
    "calt": false
  },
  "ui_font_weight": 400,
  "ui_font_size": 16,
  "unnecessary_code_fade": 0.3,
  "active_pane_modifiers": {
    "border_size": 0.0,
    "inactive_opacity": 1.0
  },
  "bottom_dock_layout": "contained",
  "pane_split_direction_horizontal": "down",
  "pane_split_direction_vertical": "right",
  "centered_layout": {
    "left_padding": 0.2,
    "right_padding": 0.2
  },
  "multi_cursor_modifier": "alt",
  "confirm_quit": false,
  "close_on_file_delete": false,
  "close_panel_on_toggle": false,
  "drop_target_size": 0.2,
  "when_closing_with_no_tabs": "platform_default",
  "on_last_window_closed": "platform_default",
  "text_rendering_mode": "platform_default",
  "zoomed_padding": true,
  "window_decorations": "client",
  "use_system_path_prompts": true,
  "use_system_prompts": true,
  "cursor_blink": true,
  "cursor_shape": "bar",
  "hide_mouse": "on_typing_and_movement",
  "focus_follows_mouse": {
    "enabled": false,
    "debounce_ms": 250
  },
  "current_line_highlight": "all",
  "selection_highlight": true,
  "rounded_selection": true,
  "minimum_contrast_for_highlights": 45,
  "colorize_brackets": false,
  "drag_and_drop_selection": {
    "enabled": true,
    "delay": 300
  },
  "show_wrap_guides": true,
  "wrap_guides": [],
  "redact_private_values": false,
  "expand_excerpt_lines": 5,
  "excerpt_context_lines": 2,
  "private_files": [
    "**/.env*",
    "**/*.pem",
    "**/*.key",
    "**/*.cert",
    "**/*.crt",
    "**/secrets.yml"
  ],
  "use_autoclose": true,
  "use_auto_surround": true,
  "auto_indent": "syntax_aware",
  "auto_indent_on_paste": true,
  "always_treat_brackets_as_autoclosed": false,
  "allow_rewrap": "in_comments",
  "show_whitespaces": "selection",
  "whitespace_map": {
    "space": "•",
    "tab": "→"
  },
  "toolbar": {
    "quick_actions": true,
    "selections_menu": true
  },
  "use_system_window_tabs": false,
  "title_bar": {
    "show_branch_status_icon": false,
    "show_branch_name": true,
    "show_project_items": true,
    "show_menus": false,
    "button_layout": "platform_default"
  },
  "scrollbar": {
    "show": "auto",
    "cursors": true,
    "search_results": true,
    "selected_text": true,
    "axes": {
      "horizontal": true,
      "vertical": true
    }
  },
  "middle_click_paste": true,
  "double_click_in_multibuffer": "select",
  "gutter": {
    "line_numbers": true,
    "folds": true,
    "min_line_number_digits": 4
  },
  "indent_guides": {
    "enabled": true,
    "line_width": 1,
    "active_line_width": 1,
    "coloring": "fixed",
    "background_coloring": "disabled"
  },
  "scroll_beyond_last_line": "one_page",
  "vertical_scroll_margin": 3,
  "autoscroll_on_clicks": false,
  "horizontal_scroll_margin": 5,
  "scroll_sensitivity": 1.0,
  "mouse_wheel_zoom": false,
  "fast_scroll_sensitivity": 4.0,
  "sticky_scroll": {
    "enabled": false
  },
  "relative_line_numbers": "disabled",
  "resize_all_panels_in_dock": [
    "left"
  ],
  "project_panel": {
    "button": true,
    "hide_gitignore": false,
    "default_width": 240,
    "dock": "right",
    "entry_spacing": "comfortable",
    "file_icons": true,
    "folder_icons": true,
    "indent_size": 20,
    "auto_reveal_entries": true,
    "starts_open": true,
    "auto_fold_dirs": true,
    "bold_folder_labels": false,
    "scrollbar": {
      "show": null,
      "horizontal_scroll": true
    },
    "sticky_scroll": true,
    "indent_guides": {
      "show": "always"
    },
    "sort_mode": "directories_first",
    "sort_order": "default",
    "drag_and_drop": true,
    "hide_root": false,
    "hide_hidden": false,
    "auto_open": {
      "on_create": true,
      "on_paste": true,
      "on_drop": true
    }
  },
  "autosave": "off",
  "max_tabs": null,
  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": true,
    "show_tab_bar_buttons": true,
    "show_pinned_tabs_in_separate_row": false
  },
  "tabs": {
    "close_position": "right",
    "file_icons": false,
    "show_close_button": "hover",
    "activate_on_close": "history"
  },
  "file_finder": {
    "file_icons": true,
    "modal_max_width": "small",
    "skip_focus_for_active_in_search": true,
    "include_ignored": "smart"
  },
  "remove_trailing_whitespace_on_save": true,
  "extend_comment_on_newline": true,
  "extend_list_on_newline": true,
  "indent_list_on_tab": true,
  "ensure_final_newline_on_save": true,
  "line_ending": "detect",
  "soft_wrap": "none",
  "preferred_line_length": 80,
  "hard_tabs": false,
  "tab_size": 4,
  "word_diff_enabled": true,
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/.sl",
    "**/.repo",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings"
  ],
  "file_scan_inclusions": [
    ".env*"
  ],
  "hidden_files": [
    "**/.*"
  ],
  "read_only_files": [],
  "status_bar": {
    "experimental.show": true,
    "show_active_file": false,
    "active_language_button": true,
    "cursor_position_button": true,
    "line_endings_button": false,
    "active_encoding_button": "non_utf8"
  },
  "file_types": {
    "JSONC": [
      "**/.zen/*.json",
      "**/.vscode/**/*.json",
      "**/{zen,Zen}/{settings,keymap}.json",
      "tsconfig*.json"
    ],
    "Markdown": [
      ".rules",
      ".cursorrules",
      ".windsurfrules",
      ".clinerules"
    ]
  },
  "languages": {
    "Markdown": {
      "remove_trailing_whitespace_on_save": false,
      "allow_rewrap": "anywhere",
      "soft_wrap": "editor_width"
    },
    "Plain Text": {
      "allow_rewrap": "anywhere",
      "soft_wrap": "editor_width"
    }
  },
  "session": {
    "restore_unsaved_buffers": true,
    "trust_all_worktrees": false
  },
  "linux": {},
  "macos": {},
  "windows": {
    "languages": {}
  },
  "line_indicator_format": "long",
  "proxy": "",
  "command_aliases": {},
  "log": {}
}
